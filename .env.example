# Runtime Environment Configuration
NODE_ENV=production
PORT=5000

# Database
# Connect string for MongoDB (Render Managed Mongo or MongoDB Atlas)
MONGO_URI=mongodb://user:password@host:27017/matcha?ssl=true

# Security
# Secret key used for signing JSON Web Tokens (min 32 characters recommended)
JWT_SECRET=super-secret-jwt-key-replace-me-in-production